// Solaris · el mar del paso de Drake como un cianotipo vivo.
// Se pinta a un tercio de la resolución y se amplía con suavizado: el grano y la viñeta van aparte, en alta.
// Las olas reflejan el cielo según su inclinación; todo se pinta con los azules del logo y la espuma en crema.
uniform float2 res;
uniform float t;
uniform float ola;
uniform float periodo;
uniform float pic;
uniform float nubes;
uniform float vis;
uniform float luz;
uniform float alba;
uniform float lluvia;
uniform float flash;
uniform float azul;

float cl(float x) { return clamp(x, 0.0, 1.0); }

float hash(float2 p) {
    float3 p3 = fract(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float ruido(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float a = hash(mod(i, 512.0));
    float b = hash(mod(i + float2(1.0, 0.0), 512.0));
    float c = hash(mod(i + float2(0.0, 1.0), 512.0));
    float d = hash(mod(i + float2(1.0, 1.0), 512.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// ruido fractal de tres octavas, normalizado alrededor de 0.5
float fbm(float2 p) {
    float s = 0.0;
    float a = 0.5;
    for (int i = 0; i < 3; i++) {
        s += a * ruido(p);
        p = float2(p.x * 1.6 - p.y * 1.2, p.x * 1.2 + p.y * 1.6) + float2(17.1, 9.2);
        a *= 0.5;
    }
    return 0.5 + (s / 0.875 - 0.5) * 1.8;
}

// una octava de oleaje: crestas agudas y valles anchos, deformada por ruido para que no se repita
float octava(float2 uv, float pico) {
    float w = ruido(uv) * 2.0 - 1.0;
    uv += float2(w, w * 0.7);
    float2 wv = 1.0 - abs(sin(uv));
    float2 swv = abs(cos(uv));
    wv = mix(wv, swv, wv);
    return pow(1.0 - pow(wv.x * wv.y, 0.65), pico);
}

// el mar de viento: tres octavas que se cruzan; las que no caben en un píxel se apagan
float viento(float2 p, float pie, float amp0, float pico0) {
    float fr = 0.16;
    float amp = amp0;
    float pico = pico0;
    float2 uv = p;
    float hh = 0.0;
    float vel = 0.8 + 0.6 * amp0;
    for (int i = 0; i < 3; i++) {
        float ver = smoothstep(1.5, 4.0, 6.2832 / fr / pie);
        float d = octava((uv + t * vel) * fr, pico) + octava((uv - t * vel) * fr, pico);
        hh += d * amp * ver;
        uv = float2(uv.x * 1.6 - uv.y * 1.2, uv.x * 1.2 + uv.y * 1.6);
        fr *= 1.9;
        amp *= 0.22;
        pico = mix(pico, 1.0, 0.2);
    }
    return hh;
}

// los azules del logo: del abismo al prusia, la niebla y la espuma crema
half3 tono(float x) {
    x = cl(x) * 7.0;
    half3 c0 = half3(0.008, 0.027, 0.059);
    half3 c1 = half3(0.024, 0.102, 0.169);
    half3 c2 = half3(0.043, 0.165, 0.251);
    half3 c3 = half3(0.071, 0.231, 0.341);
    half3 c4 = half3(0.122, 0.306, 0.431);
    half3 c5 = half3(0.373, 0.498, 0.588);
    half3 c6 = half3(0.725, 0.776, 0.800);
    half3 c7 = half3(0.929, 0.890, 0.812);
    if (x < 1.0) return mix(c0, c1, half(x));
    if (x < 2.0) return mix(c1, c2, half(x - 1.0));
    if (x < 3.0) return mix(c2, c3, half(x - 2.0));
    if (x < 4.0) return mix(c3, c4, half(x - 3.0));
    if (x < 5.0) return mix(c4, c5, half(x - 4.0));
    if (x < 6.0) return mix(c5, c6, half(x - 5.0));
    return mix(c6, c7, half(min(x - 6.0, 1.0)));
}

float cieloEn(float e) {
    return (0.50 - 0.22 * pow(cl(e), 0.7)) * (1.0 - 0.18 * nubes) - 0.06 * nubes;
}

half4 main(float2 fragCoord) {
    float W = res.x;
    float H = res.y;
    float x = fragCoord.x;
    float y = fragCoord.y;
    // el horizonte sube y baja con el mar de fondo, como desde la cubierta
    float hz = H * (0.36 + sin(t * 6.2832 / periodo) * ola * 0.0016);
    float lum = 0.0;
    float esp = 0.0;

    if (y < hz) {
        float elev = (hz - y) / hz;
        float dist = 1.0 / (elev * 1.8 + 0.16);
        float cu = (x / W - 0.5) * dist * 1.6;
        // las nubes viajan con el viento y se deshacen despacio: una deformación lenta las hace cambiar de forma
        float vn = 0.025 + pic * 0.09;
        float2 qn = float2(cu * 1.5 + t * vn * 0.35, dist * 0.92 + t * vn);
        float deforma = ruido(qn * 0.55 + float2(t * 0.018, -t * 0.011)) - 0.5;
        float nub = fbm(qn + deforma * 1.2);
        float det = ruido(float2(cu * 10.4, dist * 6.4) + float2(3.7, 1.3) + float2(t * vn * 2.5, t * vn * 6.0));
        float n = nub * 0.8 + det * 0.2;
        float brillo = 0.50 - 0.22 * pow(elev, 0.7);
        float sombra = cl((n - 0.5 + nubes * 0.25) * 2.2);
        float bruma0 = smoothstep(0.0, 0.22, elev);
        lum = brillo - (sombra * (0.10 + nubes * 0.14 + pic * 0.10) - (n - 0.5) * (0.10 + pic * 0.08)) * bruma0;
        lum *= 1.0 - 0.18 * nubes;
        lum += (0.42 - lum) * exp(-elev * 9.0) * 0.6;
        // amanecer o atardecer: el horizonte se enciende detrás de las nubes
        float dxs = (x / W - 0.62) / 0.35;
        lum += alba * 0.16 * cl(1.0 - dxs * dxs) * exp(-elev * 5.0) * (1.0 - nubes * 0.5);
        float pared = cl(1.0 - vis * 0.5);
        lum = mix(lum, 0.42 + 0.04 * (n - 0.5), pared * 0.85);
        // relámpago: las nubes se iluminan por dentro
        lum += flash * (0.25 + n * 0.3);
    } else {
        float hc = 8.4;
        float v = (y - hz) / (H - hz);
        float tana = max(v, 0.001) * 0.62;
        float z = hc / tana;
        float xw = (x / W - 0.5) * z * 1.15;
        float pie = max(z * 1.15 / W, hc / (tana * tana) * 0.62 / (H - hz));
        float Lp = 9.81 * periodo * periodo / 6.2832;

        float h = 0.0; float dx = 0.0; float dz = 0.0;
        // mar de fondo: tres trenes largos con el período real
        for (int i = 0; i < 3; i++) {
            float fi = float(i);
            float lr = i == 0 ? 1.0 : (i == 1 ? 0.63 : 0.41);
            float ang = i == 0 ? 0.05 : (i == 1 ? 0.42 : -0.5);
            float alt = i == 0 ? 0.55 : (i == 1 ? 0.30 : 0.15);
            float lam = Lp * lr;
            float k = 6.2832 / lam;
            float om = sqrt(9.81 * k);
            float a = ola * 0.5 * alt * smoothstep(3.0, 9.0, lam / pie);
            float sx = sin(ang); float sz = cos(ang);
            float th = k * (sx * xw + sz * z) - om * t + fi * 2.1;
            float s = sin(th); float c = cos(th);
            h += a * s; dx += a * k * sx * c; dz += a * k * sz * c;
        }
        float swh = h; float swz = dz;
        // mar de viento picado; la normal sale de diferencias finitas al tamaño del píxel (así se filtra solo)
        float amp0 = 0.03 + pic * 0.62 + ola * 0.02;
        float pico0 = 3.0 + pic * 2.5;
        float e = max(pie * 0.75, 0.02);
        float2 pw = float2(xw, z);
        float h0 = viento(pw, pie, amp0, pico0);
        float hx = viento(pw + float2(e, 0.0), pie, amp0, pico0);
        float hz2 = viento(pw + float2(0.0, e), pie, amp0, pico0);
        dx += (hx - h0) / e;
        dz += (hz2 - h0) / e;
        h += h0;
        float corta = h0 / (amp0 * 1.4 + 0.0001);
        float3 nrm = normalize(float3(-dx, 1.0, -dz));
        float3 vista = normalize(float3(xw, -hc, z));
        float d = dot(vista, nrm);
        float3 r = vista - 2.0 * d * nrm;
        float fres = 0.02 + 0.98 * pow(cl(1.0 + d), 5.0);
        float refl = cieloEn(asin(cl(r.y)) * 1.6);
        // el agua profunda deja pasar luz por las crestas: se aclaran desde adentro
        float atenua = exp(-z / 70.0);
        float hondo = 0.065 + 0.03 * luz + cl(dot(nrm, normalize(float3(0.1, 0.6, 1.0)))) * 0.025;
        float traslucido = cl(h0 / (amp0 + 0.0001) - 0.55) * (0.06 + pic * 0.04) * atenua;
        float cresta = swh / (ola * 0.5 + 0.05);
        float cuerpo = hondo + cl(cresta * 0.5 + 0.5) * (0.03 + pic * 0.05);
        lum = cuerpo * (1.0 - fres) + refl * fres + traslucido;
        // el lomo del mar de fondo: espaldas iluminadas, frentes en sombra; más marcado en temporal
        float lomo = cl(ola / 5.0) * (1.0 + pic * 0.8);
        lum += cl(0.5 + swz * 6.0) * 0.11 * lomo - 0.055 * lomo;
        // el sol (o la luna) velado deja un camino de luz
        float3 sol = normalize(float3(0.18, 0.10, 1.0));
        lum += pow(cl(dot(r, sol)), 180.0) * (0.9 - nubes * 0.6) * (0.4 + 0.6 * luz + alba);
        if (pic > 0.28) {
            // espuma: cabrilleo en las crestas y vetas largas que el viento estira hacia el horizonte
            // la espuma nace donde las olas cortas coinciden con la cresta del mar de fondo
            float parche = fbm(float2(xw * 0.9 + z * 0.2, z * 0.7 - t * 0.5));
            float cresta01 = cl(cresta * 0.5 + 0.5);
            float rompe = smoothstep(1.0, 1.3, corta) * smoothstep(0.75, 1.0, cresta01 * 0.6 + parche * 0.6) * smoothstep(0.3, 0.8, pic);
            float veta = smoothstep(0.9, 1.2, corta) * smoothstep(0.62, 0.8, parche) * smoothstep(0.5, 0.9, pic);
            esp = cl(rompe + veta * 0.4) * cl(1.0 - pie * 0.35);
        }
        // rocío en temporal
        lum += (0.30 - lum) * pic * 0.18 * cl(1.0 - v * 1.5);
        // distancia: el mar se pierde en la bruma
        float nb = 1.0 - exp(-z / (vis * 450.0 + 30.0));
        float bruma = cieloEn(0.0) * 0.95 + cl(1.0 - vis * 0.5) * 0.16;
        lum += (bruma - lum) * nb;
        esp *= 1.0 - nb;
        lum += flash * 0.12;
    }

    // lluvia: trazos finos y diagonales
    if (lluvia > 0.05) {
        float2 q = float2(x * 3.0 + y * 0.66, y * 0.105 + t * 22.0);
        float2 celda = floor(float2(q.x * 0.5, q.y));
        float gota = step(1.0 - cl(lluvia * 0.02) - 0.004, hash(celda));
        lum += gota * 0.07 * cl(fract(q.y) * 1.5);
    }

    // noche: la misma lámina, más hundida
    lum *= 0.62 + 0.38 * luz + alba * 0.1;
    lum = pow(cl(lum), 1.12) * 1.04;
    half3 col = tono(lum);
    // la espuma es crema, no azul: se pinta encima del tono
    col = mix(col, mix(half3(0.30, 0.42, 0.52), half3(0.93, 0.89, 0.81), half(luz)), half(esp * 0.8));
    // hora azul: todo se tiñe de prusia
    col = mix(col, col * half3(0.78, 0.94, 1.22), half(azul));
    return half4(col, 1.0);
}
