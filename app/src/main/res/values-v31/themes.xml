<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Apertura de Android 12+: negro absoluto con el ícono de Solaris, sin destello -->
    <style name="Theme.Solaris" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/noche</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/noche</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/noche</item>
    </style>
</resources>
