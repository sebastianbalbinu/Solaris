// Solaris · el mar del paso de Drake como un cianotipo vivo.
// Las olas reflejan el cielo según su inclinación; todo se pinta con la gama del logo.
uniform float2 res;
uniform float t;
uniform float ola;
uniform float periodo;
uniform float pic;
uniform float nubes;
uniform float vis;
uniform float luz;
uniform float alba;
uniform float lluvia;
uniform float flash;
uniform float semilla;

float cl(float x) { return clamp(x, 0.0, 1.0); }

float hash(float2 p) {
    float3 p3 = fract(float3(p.x, p.y, p.x) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float ruido(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float a = hash(mod(i, 512.0));
    float b = hash(mod(i + float2(1.0, 0.0), 512.0));
    float c = hash(mod(i + float2(0.0, 1.0), 512.0));
    float d = hash(mod(i + float2(1.0, 1.0), 512.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// ruido fractal normalizado: media 0.5, desviación cercana a 0.18
float fbm(float2 p) {
    float s = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
        s += a * ruido(p);
        // cada octava girada para que no aparezca la cuadrícula
        p = float2(p.x * 1.6 - p.y * 1.2, p.x * 1.2 + p.y * 1.6) + float2(17.1, 9.2);
        a *= 0.5;
    }
    return 0.5 + (s / 0.9375 - 0.5) * 1.7;
}

// la gama del logo, de la sombra azul al crema
half3 tono(float x) {
    x = cl(x) * 7.0;
    half3 c0 = half3(0.002, 0.034, 0.070);
    half3 c1 = half3(0.047, 0.175, 0.219);
    half3 c2 = half3(0.180, 0.313, 0.341);
    half3 c3 = half3(0.343, 0.440, 0.440);
    half3 c4 = half3(0.519, 0.562, 0.529);
    half3 c5 = half3(0.700, 0.683, 0.612);
    half3 c6 = half3(0.892, 0.801, 0.683);
    half3 c7 = half3(0.930, 0.880, 0.780);
    if (x < 1.0) return mix(c0, c1, half(x));
    if (x < 2.0) return mix(c1, c2, half(x - 1.0));
    if (x < 3.0) return mix(c2, c3, half(x - 2.0));
    if (x < 4.0) return mix(c3, c4, half(x - 3.0));
    if (x < 5.0) return mix(c4, c5, half(x - 4.0));
    if (x < 6.0) return mix(c5, c6, half(x - 5.0));
    return mix(c6, c7, half(min(x - 6.0, 1.0)));
}

float cieloEn(float e) {
    return (0.50 - 0.22 * pow(cl(e), 0.7)) * (1.0 - 0.18 * nubes) - 0.06 * nubes;
}

half4 main(float2 fragCoord) {
    float W = res.x;
    float H = res.y;
    float x = fragCoord.x;
    float y = fragCoord.y;
    // el horizonte sube y baja con el mar de fondo, como desde la cubierta
    float hz = H * (0.36 + sin(t * 6.2832 / periodo) * ola * 0.0016);
    float lum = 0.0;

    if (y < hz) {
        float elev = (hz - y) / hz;
        float dist = 1.0 / (elev * 1.8 + 0.06);
        float cu = (x / W - 0.5) * dist * 1.6;
        float nub = fbm(float2(cu * 1.5, dist * 0.92 + t * 0.03));
        float det = fbm(float2(cu * 10.4, dist * 6.4) + float2(3.7, 1.3));
        float n = nub * 0.75 + det * 0.25;
        float brillo = 0.50 - 0.22 * pow(elev, 0.7);
        float sombra = cl((n - 0.5 + nubes * 0.25) * 2.2);
        lum = brillo - sombra * (0.10 + nubes * 0.14 + pic * 0.10) + (n - 0.5) * (0.10 + pic * 0.08);
        lum *= 1.0 - 0.18 * nubes;
        lum += (0.42 - lum) * exp(-elev * 9.0) * 0.6;
        // amanecer o atardecer: el horizonte se enciende detrás de las nubes
        float dxs = (x / W - 0.62) / 0.35;
        lum += alba * 0.16 * cl(1.0 - dxs * dxs) * exp(-elev * 5.0) * (1.0 - nubes * 0.5);
        // relámpago: las nubes se iluminan por dentro
        lum += flash * (0.25 + n * 0.3);
    } else {
        float hc = 8.4;
        float v = (y - hz) / (H - hz);
        float tana = max(v, 0.001) * 0.62;
        float z = hc / tana;
        float xw = (x / W - 0.5) * z * 1.15;
        float pie = max(z * 1.15 / W, hc / (tana * tana) * 0.62 / (H - hz));
        float Lp = 9.81 * periodo * periodo / 6.2832;
        float vf = 0.25 + pic * 0.9;

        float h = 0.0; float dx = 0.0; float dz = 0.0; float hf = 0.0;
        // mar de fondo: tres trenes largos con el período real
        for (int i = 0; i < 3; i++) {
            float fi = float(i);
            float lr = i == 0 ? 1.0 : (i == 1 ? 0.63 : 0.41);
            float ang = i == 0 ? 0.05 : (i == 1 ? 0.42 : -0.5);
            float alt = i == 0 ? 0.55 : (i == 1 ? 0.30 : 0.15);
            float lam = Lp * lr;
            float k = 6.2832 / lam;
            float om = sqrt(9.81 * k);
            float a = ola * 0.5 * alt * smoothstep(3.0, 9.0, lam / pie);
            float sx = sin(ang); float sz = cos(ang);
            float th = k * (sx * xw + sz * z) - om * t + fi * 2.1;
            float s = sin(th); float c = cos(th);
            h += a * s; dx += a * k * sx * c; dz += a * k * sz * c;
        }
        float swh = h; float swz = dz;
        // mar de viento: olas cortas que le dan la piel al agua
        float lam0 = max(Lp * 0.3, 6.0);
        float paso = pow(0.25 / lam0, 1.0 / 21.0);
        float lam = lam0;
        for (int i = 0; i < 22; i++) {
            float fi = float(i);
            // direcciones y fases repartidas con la proporción áurea: variadas y sin patrón
            float ang = 0.25 + (hash(float2(fi, 3.1)) + hash(float2(fi, 8.9)) - 1.0) * 1.6;
            float a = 0.05 * lam * vf * 0.5 * (0.6 + 0.8 * fract(fi * 0.618034 + 0.3)) * pow(lam / lam0, 0.3);
            float k = 6.2832 / lam;
            float om = sqrt(9.81 * k);
            float aa = a * smoothstep(3.0, 9.0, lam / pie);
            float sx = sin(ang); float sz = cos(ang);
            float th = k * (sx * xw + sz * z) - om * t + fract(fi * 0.754877) * 6.2832;
            float s = sin(th); float c = cos(th);
            h += aa * s; dx += aa * k * sx * c; dz += aa * k * sz * c;
            if (lam < 3.0) hf += aa * s / (a + 0.000001);
            lam *= paso;
        }
        float3 nrm = normalize(float3(-dx, 1.0, -dz));
        float3 vista = normalize(float3(xw, -hc, z));
        float d = dot(vista, nrm);
        float3 r = vista - 2.0 * d * nrm;
        float fres = 0.02 + 0.98 * pow(cl(1.0 + d), 5.0);
        float refl = cieloEn(asin(cl(r.y)) * 1.6);
        float cresta = swh / (ola * 0.5 + 0.05);
        float cuerpo = 0.085 + cl(cresta * 0.5 + 0.5) * (0.05 + pic * 0.07);
        lum = cuerpo * (1.0 - fres) + refl * fres;
        // el lomo del mar de fondo: espaldas iluminadas, frentes en sombra
        lum += cl(0.5 + swz * 6.0) * 0.10 * cl(ola / 5.0) - 0.05 * cl(ola / 5.0);
        // el sol velado deja un camino de luz
        float3 sol = normalize(float3(0.18, 0.10, 1.0));
        lum += pow(cl(dot(r, sol)), 180.0) * (0.9 - nubes * 0.6) * (0.4 + 0.6 * luz + alba);
        if (pic > 0.28) {
            // espuma: rompientes en jirones y vetas largas con el viento
            float T1 = fbm(float2(xw * 0.2, z * 0.06 - t * 0.2));
            float T2 = fbm(float2(xw * 1.1, z * 0.5) + float2(5.1, 2.3));
            float vetas = T1 * 0.6 + T2 * 0.4;
            float cresta01 = cl(cresta);
            float rompe = smoothstep(0.9, 1.9, hf / 6.0 + pic * 0.6 + cresta01 * 0.4) * smoothstep(0.42, 0.62, vetas);
            float T3 = fbm(float2(xw * 0.32, z * 0.22 - t * 0.25) + float2(9.3, 4.4)) * 0.6 + fbm(float2(xw * 1.4, z * 0.9) + float2(1.7, 8.1)) * 0.4;
            float manto = smoothstep(0.58, 0.74, T3 + pic * 0.06) * smoothstep(0.45, 0.85, pic) * cl(cresta + 0.6);
            float bl = cl(rompe * smoothstep(0.3, 0.75, pic) + manto * 0.35) * cl(1.0 - pie * 0.4);
            lum += bl * 0.40;
        }
        // rocío y aguacero en temporal
        lum += (0.30 - lum) * pic * 0.18 * cl(1.0 - v * 1.5);
        // distancia: el mar se pierde en la bruma
        float nb = 1.0 - exp(-z / (vis * 450.0 + 30.0));
        lum += (cieloEn(0.0) * 0.95 - lum) * nb;
        lum += flash * 0.12;
    }

    // lluvia: trazos finos y diagonales
    if (lluvia > 0.05) {
        float2 q = float2(x + y * 0.22, y * 0.035 + t * 22.0);
        float2 celda = floor(float2(q.x * 0.5, q.y));
        float gota = step(1.0 - cl(lluvia * 0.02) - 0.004, hash(celda));
        lum += gota * 0.07 * cl(fract(q.y) * 1.5);
    }

    // noche: la misma lámina, más hundida
    lum *= 0.62 + 0.38 * luz + alba * 0.1;
    lum = pow(cl(lum), 1.12) * 1.04;
    half3 col = tono(lum);

    // grano de película y papel
    float g = (hash(fragCoord + semilla * 37.0) + hash(fragCoord * 1.37 + semilla * 11.0) - 1.0) * 0.045;
    float papel = (ruido(fragCoord / 140.0) * 0.6 + ruido(fragCoord / 47.0) * 0.4 - 0.5) * 0.045;
    col += half3(g + papel);
    // viñeta
    float vx = (x / W - 0.5) / 0.62;
    float vy = (y / H - 0.5) / 0.68;
    float rr = sqrt(vx * vx + vy * vy);
    col *= half(1.0 - 0.5 * pow(cl(rr - 0.35), 1.5));
    return half4(col, 1.0);
}
